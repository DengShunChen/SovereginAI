# 中央氣象署開放資料 API 授權碼
# 申請位置：https://opendata.cwa.gov.tw/user/authkey
CWA_API_AUTH_KEY=

# 若出現 SSL: CERTIFICATE_VERIFY_FAILED（如 Missing Subject Key Identifier），可設為 0 略過 SSL 驗證
# CWA_SSL_VERIFY=0

# Hugging Face 發布語料用（選填；需 Write 權限）。不填則使用 huggingface-cli login 的憑證
# HF_TOKEN=

# Hugging Face 語料 repo（選填）。若設定且 HF_TOKEN 或已 login，則 run_collect_and_prepare.sh 完成後會自動 push
# HF_REPO_ID=dschen/sovereign-weather-corpus

# Hugging Face 模型 repo（選填）。訓練完成後用於發布模型：python scripts/publish_model_to_huggingface.py --repo_id $HF_MODEL_REPO
# HF_MODEL_REPO=dschen/sovereign-weather-ai
